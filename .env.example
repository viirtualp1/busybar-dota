# USB: BUSY_ADDR=10.0.4.20, leave token and password empty.
# Wi-Fi: BUSY_ADDR=<Bar LAN IP>, BUSY_HTTP_PASSWORD=<HTTP Access password>, leave BUSY_TOKEN empty.
# Cloud: BUSY_ADDR=https://api.busy.app + BUSY_TOKEN.
BUSY_ADDR=10.0.4.20
BUSY_TOKEN=
BUSY_HTTP_PASSWORD=

# Free key from https://steamcommunity.com/dev/apikey
# With a key you get per-player K/D/A, tower state and series score.
# Without one it falls back to OpenDota /live: teams, kills and net worth only.
STEAM_API_KEY=

# Optional. Pin to one tournament or one game.
# Leave both empty to follow whichever pro game has the most spectators —
# during TI that is reliably the main stage.
LEAGUE_ID=
MATCH_ID=

# Upstreams refresh every few seconds; polling faster only burns rate limit.
# Sounds fire on towers, barracks, Roshan and the game starting or ending.
# Kills are always silent. Set to 0 to mute everything.
SOUNDS=1

# Once both drafts are full, the bans are drawn as hero portraits on the back.
# The icons are fetched once and uploaded to the Bar's app assets. Set to 0 to
# keep the bans as text.
BAN_PORTRAITS=1

# How a line too long for 72px is shown.
# page   — break on words and hold each chunk still (default; nothing to stutter)
# scroll — move the line like a news ticker
TICKER_STYLE=page

# Glyphs assumed to fit on one line of the 72px front display. The default is
# deliberately conservative (4px a glyph); if short lines page when they plainly
# had room to sit still, raise this until they stop.
TICKER_CHARS=17

POLL_MS=5000
FRAME_MS=200
REQUEST_TIMEOUT_MS=10000
DRAW_PRIORITY=40

# Between-games view: countdown, start time and bracket.
# json   — hand-maintained file (default when SCHEDULE_FILE exists)
# stratz — needs STRATZ_TOKEN; query written to spec but never run, see README
# demo   — synthetic schedule
# none   — plain idle screen
SCHEDULE_SOURCE=json
SCHEDULE_FILE=schedule.json
STRATZ_TOKEN=

# Set to 1 to run the synthetic match instead of live data (same as --demo).
DEMO=
