# USB: BUSY_ADDR=10.0.4.20, leave token and password empty.
# Wi-Fi: BUSY_ADDR=<Bar LAN IP>, BUSY_HTTP_PASSWORD=<HTTP Access password>, leave BUSY_TOKEN empty.
# Cloud: BUSY_ADDR=https://api.busy.app + BUSY_TOKEN.
BUSY_ADDR=10.0.4.20
BUSY_TOKEN=
BUSY_HTTP_PASSWORD=

# Free key from https://steamcommunity.com/dev/apikey
# With a key you get per-player K/D/A, tower state and series score.
# Without one it falls back to OpenDota /live: teams, kills and net worth only.
STEAM_API_KEY=

# Optional. Pin to one tournament or one game.
# Leave both empty to follow whichever pro game has the most spectators —
# during TI that is reliably the main stage.
LEAGUE_ID=
MATCH_ID=

# Upstreams refresh every few seconds; polling faster only burns rate limit.
POLL_MS=5000
FRAME_MS=200
REQUEST_TIMEOUT_MS=10000
DRAW_PRIORITY=40

# Set to 1 to run the synthetic match instead of live data (same as --demo).
DEMO=
